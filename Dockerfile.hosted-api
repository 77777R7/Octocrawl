# Hosted Octocrawl, phase 1 (ROADMAP PH): the hosted API and the remote MCP endpoint in one process.
# Built by cloudbuild.hosted-api.yaml; deployed as the Cloud Run service `octocrawl-api` (docs/hosted-api.md).
FROM node:22-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
# The reviewed Amazon product contract, read by packages/mcp at startup for the scrape_product tool.
COPY research/amazon-product-schema.v1.json ./research/amazon-product-schema.v1.json

# better-sqlite3 is in the workspace dependency graph; a node-gyp fallback for when no prebuilt binary matches.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
# Chromium: the browser lane for key holders (keyless callers read over HTTP alone).
RUN npm ci && npx playwright install --with-deps chromium && npm run typecheck

ENV NODE_ENV=production
ENV PORT=8080
# Cloud Run keeps the filesystem in memory: the task root is swept every minute (hostedApi.ts, sweepTaskRoot).
ENV W2L_TASK_ROOT=/tmp/octocrawl-hosted
EXPOSE 8080
CMD ["node", "packages/mcp/dist/hostedApiCli.js"]
