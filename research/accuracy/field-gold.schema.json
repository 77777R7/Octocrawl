{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:octocrawl:field-gold:1",
  "title": "Octocrawl engineering field gold annotation",
  "type": "object",
  "required": [
    "schema",
    "id",
    "split",
    "url",
    "task",
    "rawSha256",
    "sourceCapturedAt",
    "annotationStatus",
    "nonAuthorReview",
    "exposure",
    "entities",
    "units",
    "dates",
    "periods",
    "fields"
  ],
  "properties": {
    "schema": {
      "const": "octocrawl.field-gold/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[DH][0-9]{2}$"
    },
    "split": {
      "enum": [
        "development",
        "reserved"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "rawSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCapturedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "annotationStatus": {
      "const": "engineering_source_checked"
    },
    "nonAuthorReview": {
      "type": [
        "object",
        "null"
      ]
    },
    "exposure": {
      "type": "object",
      "required": [
        "usedForTuning",
        "candidateEvaluated"
      ],
      "properties": {
        "usedForTuning": {
          "type": "boolean"
        },
        "candidateEvaluated": {
          "type": "boolean"
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "span",
          "sourceRecordCaptured"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "span": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "sourceRecordCaptured": {
            "type": "boolean"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/context"
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/context"
      }
    },
    "periods": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/context"
      }
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "required": [
        "start",
        "end",
        "byteStart",
        "byteEnd",
        "quote",
        "mode"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "byteStart": {
          "type": "integer",
          "minimum": 0
        },
        "byteEnd": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "text",
            "attribute",
            "literal"
          ]
        },
        "attribute": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "required": [
        "state",
        "value",
        "evidence",
        "normalization"
      ],
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          }
        },
        "normalization": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "entityId",
        "name",
        "dataType",
        "required",
        "availability",
        "value",
        "unitRef",
        "dateRef",
        "evidence",
        "normalization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entityId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "dataType": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "availability": {
          "enum": [
            "captured",
            "not_captured",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "unitRef": {
          "type": "string"
        },
        "dateRef": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proof"
          }
        },
        "normalization": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "captured"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
