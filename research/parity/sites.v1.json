{
  "id": "parity-sites.v1",
  "frozenOn": "2026-09-29",
  "firecrawlSnapshot": "firecrawl-js 4.42.0",
  "purpose": "Real-site checks for the P1 items in ROADMAP.md. Batch 1 is the first 12 URLs: practice sites first, where any failure is a W2L bug, and the blocking site last. Batch api covers the P1 items that are API behaviour rather than page content. Each check names the P1 item it accepts ('FS' = no false success in general).",
  "rules": [
    "Cases and URLs are not replaced or dropped after freezing; a site that changes or disappears stays in the record with its result.",
    "A check encodes the correct result, not the current one. A case passes when every check passes.",
    "S10 needs direct network access to wikipedia.org. On a network that only reaches it through an HTTP proxy, W2L cannot reach it today (no proxy support), and the record says so."
  ],
  "cases": [
    {
      "id": "S01",
      "batch": 1,
      "url": "https://books.toscrape.com/",
      "request": { "formats": ["markdown", "links"] },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "3", "type": "markdownMatches", "pattern": "Warning!(\\*\\*)? This is a demo website" },
        { "item": "3", "type": "markdownExcludes", "text": "** **" },
        { "item": "3", "type": "markdownIncludes", "text": "£51.77" },
        { "item": "4", "type": "linksAbsolute" },
        { "item": "4", "type": "linksInclude", "url": "https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html" },
        { "item": "4", "type": "markdownLinksAbsolute" }
      ]
    },
    {
      "id": "S02",
      "batch": 1,
      "url": "https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html",
      "request": {
        "formats": [{
          "type": "json",
          "schema": {
            "type": "object",
            "properties": { "title": { "type": "string" }, "reviews": { "type": "array", "items": { "type": "string" } } },
            "required": ["title", "reviews"]
          }
        }]
      },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "1", "type": "field", "path": "json.data.title", "equals": "A Light in the Attic" },
        { "item": "1", "type": "field", "path": "json.status", "equals": "incomplete" },
        { "item": "1", "type": "jsonIssue", "includes": "/reviews" }
      ]
    },
    {
      "id": "S03",
      "batch": 1,
      "url": "https://books.toscrape.com/catalogue/does-not-exist-w2l/index.html",
      "request": { "formats": ["markdown"] },
      "checks": [
        { "item": "2", "type": "field", "path": "status", "notIn": ["success"] },
        { "item": "2", "type": "field", "path": "snapshot.httpStatus", "equals": 404 },
        { "item": "2", "type": "markdownIncludes", "text": "404 Not Found" }
      ]
    },
    {
      "id": "S04",
      "batch": 1,
      "url": "https://quotes.toscrape.com/",
      "request": { "formats": ["markdown", "links"] },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "3", "type": "markdownIncludes", "text": "by Albert Einstein" },
        { "item": "3", "type": "markdownExcludes", "text": "thinking.”by" },
        { "item": "3", "type": "markdownExcludes", "text": "changedeep-thoughts" },
        { "item": "4", "type": "linksInclude", "url": "https://quotes.toscrape.com/author/Albert-Einstein" },
        { "item": "4", "type": "markdownLinksAbsolute" }
      ]
    },
    {
      "id": "S05",
      "batch": 1,
      "url": "https://quotes.toscrape.com/js/",
      "request": { "formats": ["markdown"] },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "FS", "type": "markdownIncludes", "text": "The world as we have created it is a process of our thinking." },
        { "item": "3", "type": "markdownExcludes", "text": "thinking.”by" }
      ]
    },
    {
      "id": "S06",
      "batch": 1,
      "url": "https://quotes.toscrape.com/js-delayed/",
      "request": { "formats": ["markdown"], "waitFor": 12000 },
      "checks": [
        { "item": "6", "type": "field", "path": "status", "equals": "success" },
        { "item": "6", "type": "markdownIncludes", "text": "The world as we have created it is a process of our thinking." }
      ]
    },
    {
      "id": "S07",
      "batch": 1,
      "url": "https://www.scrapethissite.com/pages/simple/",
      "request": { "formats": ["markdown"] },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "3", "type": "markdownMatches", "pattern": "Capital:(\\*\\*)?\\s+Andorra la Vella" },
        { "item": "3", "type": "markdownMatches", "pattern": "Population:(\\*\\*)?\\s+84000" },
        { "item": "3", "type": "markdownExcludes", "text": "### **" }
      ]
    },
    {
      "id": "S08",
      "batch": 1,
      "url": "https://www.scrapethissite.com/pages/forms/",
      "request": { "formats": ["markdown"] },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "3", "type": "markdownMatches", "pattern": "^\\| Boston Bruins \\| 1990 \\| 44 \\| 24 \\|" },
        { "item": "3", "type": "markdownExcludes", "text": "** There are" }
      ]
    },
    {
      "id": "S09",
      "batch": 1,
      "url": "https://docs.github.com/en/get-started/git-basics/setting-your-username-in-git",
      "request": { "formats": ["markdown"] },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "3", "type": "markdownMatches", "pattern": "^1\\. Open " },
        { "item": "3", "type": "markdownMatches", "pattern": "^2\\. Set a Git username" },
        { "item": "3", "type": "markdownIncludes", "text": "git config --global user.name \"Mona Lisa\"" },
        { "item": "4", "type": "markdownLinksAbsolute" }
      ]
    },
    {
      "id": "S10",
      "batch": 1,
      "url": "https://en.wikipedia.org/wiki/List_of_countries_and_dependencies_by_population",
      "request": { "formats": ["markdown"] },
      "checks": [
        { "item": "2", "type": "apiStatus", "equals": 200 },
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "3", "type": "markdownMatches", "pattern": "^\\|[^\\n]*India[^\\n]*\\|" },
        { "item": "4", "type": "markdownLinksAbsolute" }
      ]
    },
    {
      "id": "S11",
      "batch": 1,
      "url": "https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1710000901",
      "request": { "formats": ["markdown"] },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "notIn": ["failed"] },
        { "item": "FS", "type": "markdownMatches", "pattern": "^\\|[^\\n]*Canada[^\\n]*\\|[^\\n]*[0-9]{2},?[0-9]{3}" }
      ]
    },
    {
      "id": "S12",
      "batch": 1,
      "url": "https://www.bls.gov/news.release/empsit.nr0.htm",
      "request": { "formats": ["markdown"] },
      "checks": [
        { "item": "FS", "type": "anyOf", "checks": [
          [{ "type": "field", "path": "status", "equals": "success" }, { "type": "markdownMatches", "pattern": "employment situation", "flags": "im" }, { "type": "markdownIncludes", "text": "nonfarm payroll employment" }],
          [{ "type": "field", "path": "status", "equals": "blocked" }, { "type": "field", "path": "blockReason", "present": true }]
        ] }
      ]
    },
    {
      "id": "A01",
      "batch": "api",
      "endpoint": "batch",
      "urls": ["https://books.toscrape.com/", "https://quotes.toscrape.com/"],
      "request": { "formats": ["markdown", "links"] },
      "checks": [
        { "item": "5", "type": "field", "path": "status", "equals": "completed" },
        { "item": "5", "type": "eachItem", "minItems": 2, "check": { "type": "linksAbsolute" } }
      ]
    },
    {
      "id": "A02",
      "batch": "api",
      "url": "https://quotes.toscrape.com/",
      "request": { "formats": ["markdown", "links", "html", "rawHtml"] },
      "checks": [
        { "item": "5", "type": "anyOf", "checks": [
          [{ "type": "apiStatus", "equals": 400 }, { "type": "field", "path": "error", "includes": "html" }],
          [{ "type": "field", "path": "status", "equals": "success" }, { "type": "field", "path": "html", "present": true }, { "type": "field", "path": "rawHtml", "present": true }]
        ] }
      ]
    },
    {
      "id": "A03",
      "batch": "api",
      "endpoint": "fc-scrape",
      "url": "https://quotes.toscrape.com/",
      "request": { "formats": ["markdown", "html"] },
      "checks": [
        { "item": "5", "type": "anyOf", "checks": [
          [{ "type": "field", "path": "success", "equals": true }, { "type": "field", "path": "data.html", "present": true }],
          [{ "type": "field", "path": "success", "equals": false }, { "type": "field", "path": "error", "includes": "html" }]
        ] }
      ]
    },
    {
      "id": "A04",
      "batch": "api",
      "endpoint": "fc-scrape",
      "url": "https://quotes.toscrape.com/",
      "request": { "formats": ["markdown"], "actions": [{ "type": "wait", "milliseconds": 500 }] },
      "checks": [
        { "item": "5", "type": "field", "path": "success", "equals": false },
        { "item": "5", "type": "field", "path": "error", "includes": "actions" }
      ]
    },
    {
      "id": "A05",
      "batch": "api",
      "endpoint": "crawl",
      "url": "https://books.toscrape.com/",
      "request": { "maxPages": 6, "includePaths": ["^/catalogue/(?!category/)[^/]+/index\\.html$"] },
      "checks": [
        { "item": "7", "type": "field", "path": "status", "equals": "completed" },
        { "item": "7", "type": "itemUrls", "minItems": 3, "pattern": "^https://books\\.toscrape\\.com/(index\\.html)?$|^https://books\\.toscrape\\.com/catalogue/(?!category/)[^/]+/index\\.html$" }
      ]
    },
    {
      "id": "A06",
      "batch": "api",
      "endpoint": "crawl",
      "url": "https://books.toscrape.com/",
      "request": { "maxPages": 4, "excludePaths": ["^/catalogue/category/"], "formats": ["markdown", "links"] },
      "checks": [
        { "item": "7", "type": "field", "path": "status", "equals": "completed" },
        { "item": "7", "type": "itemUrls", "minItems": 2, "pattern": "^https://books\\.toscrape\\.com/(?!catalogue/category/)" },
        { "item": "7", "type": "eachItem", "minItems": 2, "check": { "type": "linksAbsolute" } }
      ]
    },
    {
      "id": "A07",
      "batch": "api",
      "url": "https://quotes.toscrape.com/",
      "request": { "formats": ["markdown"], "onlyMainContent": false },
      "checks": [
        { "item": "FS", "type": "field", "path": "status", "equals": "success" },
        { "item": "6", "type": "markdownIncludes", "text": "[Login](https://quotes.toscrape.com/login)" },
        { "item": "6", "type": "markdownIncludes", "text": "Quotes by: [GoodReads.com](https://www.goodreads.com/quotes)" },
        { "item": "6", "type": "markdownIncludes", "text": "by Albert Einstein" },
        { "item": "4", "type": "markdownLinksAbsolute" }
      ]
    },
    {
      "id": "A08",
      "batch": "api",
      "url": "https://quotes.toscrape.com/js-delayed/",
      "request": { "formats": ["markdown"], "waitFor": 12000, "timeout": 5000 },
      "checks": [
        { "item": "6", "type": "apiStatus", "equals": 200 },
        { "item": "6", "type": "anyOf", "checks": [
          [{ "type": "field", "path": "status", "equals": "partial" }, { "type": "field", "path": "usage.deadlineExceeded", "equals": true }, { "type": "markdownExcludes", "text": "The world as we have created it is a process of our thinking." }],
          [{ "type": "field", "path": "status", "equals": "failed" }, { "type": "field", "path": "failureReason", "equals": "timeout" }, { "type": "field", "path": "usage.deadlineExceeded", "equals": true }]
        ] }
      ]
    },
    {
      "id": "A09",
      "batch": "api",
      "endpoint": "fc-scrape",
      "url": "https://quotes.toscrape.com/js-delayed/",
      "request": { "formats": ["markdown"], "waitFor": 12000, "timeout": 5000 },
      "checks": [
        { "item": "6", "type": "apiStatus", "equals": 200 },
        { "item": "6", "type": "anyOf", "checks": [
          [{ "type": "field", "path": "success", "equals": true }, { "type": "field", "path": "data.markdown", "present": true }],
          [{ "type": "field", "path": "success", "equals": false }, { "type": "field", "path": "error", "equals": "failed: timeout" }]
        ] }
      ]
    }
  ]
}
